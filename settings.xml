<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings. Use with:  mvn -s settings.xml <goal>

  The local proxy at 127.0.0.1:7897 causes flaky TLS handshake resets against
  repo1.maven.org / maven.google.com, so we route everything through the Aliyun
  public mirror (mirrors Maven Central + Google + Spring + Sonatype). See the
  project's recorded build note ("jadx build needs Aliyun mirror").
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <mirrors>
        <mirror>
            <id>aliyun-public</id>
            <name>Aliyun Public Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>*,!google-maven</mirrorOf>
        </mirror>
        <mirror>
            <id>aliyun-google</id>
            <name>Aliyun Google Mirror</name>
            <url>https://maven.aliyun.com/repository/google</url>
            <mirrorOf>google-maven</mirrorOf>
        </mirror>
    </mirrors>
</settings>
