<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zin.jadxheadless</groupId>
    <artifactId>jadx-headless-mcp-v2</artifactId>
    <version>1.1.1</version>
    <packaging>jar</packaging>
    <name>jadx-headless-mcp-v2</name>
    <description>Headless jadx decompiler + MCP server (single-process, Streamable HTTP) for reverse engineering</description>

    <properties>
        <!-- Jetty 12 + MCP SDK require Java 17. jadx artifacts are Java 11 bytecode (forward compatible). -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jadx.version>1.5.5</jadx.version>
        <mcp.sdk.version>1.1.3</mcp.sdk.version>
        <jetty.version>12.0.16</jetty.version>
        <sqlite.version>3.45.3.0</sqlite.version>
        <jackson2.version>2.17.2</jackson2.version>
        <slf4j.version>2.0.13</slf4j.version>
    </properties>

    <repositories>
        <repository>
            <id>maven-central</id>
            <url>https://repo1.maven.org/maven2</url>
        </repository>
        <repository>
            <id>google-maven</id>
            <url>https://maven.google.com</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- ============ jadx (published artifacts, NOT the vendored source tree) ============ -->
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-core</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-dex-input</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-java-input</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-smali-input</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-java-convert</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-aab-input</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-xapk-input</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-apkm-input</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-apks-input</artifactId>
            <version>${jadx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-kotlin-metadata</artifactId>
            <version>${jadx.version}</version>
        </dependency>

        <!-- ============ MCP Java SDK (official, non-Spring core; Streamable HTTP servlet lives here) ============ -->
        <!-- Aggregator pulls mcp-core + mcp-json-jackson3 (Jackson 3, groupId tools.jackson.*). -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>${mcp.sdk.version}</version>
        </dependency>

        <!-- ============ Embedded servlet container: Jetty 12 EE10 (jakarta.servlet 6) ============ -->
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <version>${jetty.version}</version>
        </dependency>

        <!-- ============ SQLite (bundled native + FTS5 incl. trigram tokenizer) ============ -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- NB: we deliberately do NOT depend on our own Jackson. The MCP SDK bundles Jackson 3
             (tools.jackson.*) with a matching jackson-annotations; adding a second Jackson here caused
             a NoSuchMethodError (stale jackson-annotations shadowing JsonProperty.isRequired()). Our own
             tool-result JSON is hand-rolled in util/Json; the rename journal uses a TSV format. -->

        <!-- ============ Logging: slf4j-simple → stderr (stdout stays clean) ============ -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Nullability annotations (jadx-core's API uses them; we reuse @NotNull/@Nullable). -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>jadx-headless-mcp-v2</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Runnable fat jar. NO relocation (standalone app, not a jadx plugin). -->
            <!-- ServicesResourceTransformer is MANDATORY: merges META-INF/services so jadx input -->
            <!-- plugins, kotlin-metadata, the MCP json ServiceLoader, and sqlite-jdbc are all found. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.zin.jadxheadless.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
